#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/app/node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/bin/node_modules:/app/node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/node_modules:/app/node_modules/.pnpm/esbuild@0.27.7/node_modules:/app/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/app/node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/bin/node_modules:/app/node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/node_modules:/app/node_modules/.pnpm/esbuild@0.27.7/node_modules:/app/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/bin/esbuild" "$@"
else
  exec node  "$basedir/../../../../node_modules/.pnpm/esbuild@0.27.7/node_modules/esbuild/bin/esbuild" "$@"
fi
