# ─────────────────────────────────────────────────────────────────────────────
# Kylrix — Environment Variables (committed template)
# Copy to your local .env (gitignored) and fill in real values:
#   cp env.sample .env
# Self-host: ./selfhost.sh mints .env automatically; shell exports override (see SELFHOST.md)
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
APP_PORT=5003
APPWRITE_PORT=8080

# ── Domain ─────────────────────────────────────────────────────────────────
DOMAIN=localhost
APPWRITE_DOMAIN=localhost
APPWRITE_FUNCTIONS_DOMAIN=functions.localhost

# ── Appwrite (bundled self-host defaults) ──────────────────────────────────
# Internal Docker network endpoint (server-side SDK)
APPWRITE_ENDPOINT=http://appwrite/v1
# Browser-facing endpoint (must match APPWRITE_PORT)
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost:8080/v1
# Minted automatically by selfhost/bootstrap.sh — leave blank on first run
APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_API=

# ── Application URLs ───────────────────────────────────────────────────────
APP_URL=http://localhost:5003
NEXT_PUBLIC_APP_URL=http://localhost:5003
NEXT_PUBLIC_APP_URI=http://localhost:5003
NEXT_PUBLIC_ORIGIN=http://localhost:5003
SELFHOSTED=true

# ── Bootstrap admin (minted by selfhost/mint-env.sh) ───────────────────────
SELFHOST_ADMIN_EMAIL=admin@example.com
SELFHOST_ADMIN_PASSWORD=

# ── Bundled Appwrite infrastructure secrets (minted on first run) ──────────
APPWRITE_OPENSSL_KEY=
MARIADB_USER=appwrite
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# ── Bundled Appwrite (lean API-only stack — no console container) ───────────
# Stable default: 1.9.6. Set APPWRITE_UNSTABLE=true for 2.0.0-rc.1 (dogfood only).
APPWRITE_UNSTABLE=false
APPWRITE_IMAGE=appwrite/appwrite:1.9.6

# ── Authentication methods (independent of SELFHOSTED) ───────────────────
# Allow new accounts via email + password (off by default — enable for self-host)
AUTH_EMAIL_PASSWORD_SIGNUP=false
# Allow new accounts via passkey (signup UI wiring is incremental)
AUTH_PASSKEY_SIGNUP=false
# When true, disables ALL password auth (signup + signin). No effect when false.
AUTH_PASSWORDLESS_MODE=false

# ── Security ───────────────────────────────────────────────────────────────
ADMINS=
KYLRIX_INTERNAL_JOBS_SECRET=
ATTACHMENT_URL_SIGNING_SECRET=
ATTACHMENT_URL_TTL_SECONDS=300
AUTH_SUBDOMAIN=accounts

# ── Email (SMTP) — optional for local installs ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SYSTEM_EMAIL=noreply@localhost
SECURITY_EMAIL=security@localhost

# ── Storage Limits ─────────────────────────────────────────────────────────
STORAGE_LIMIT=30000000
STORAGE_PREVIEW_LIMIT=20000000

# ── Product & Pricing ───────────────────────────────────────────────────────
PRODUCT_NAME=Kylrix
PRICING_TIERS_ENABLED=false
PRICING_PLAN_COUNT=2

PRICING_PLAN_1_NAME="Example Tier A"
PRICING_PLAN_1_DESCRIPTION="Demo individual plan"
PRICING_PLAN_1_PRICE_USD=9
PRICING_PLAN_1_LEDGER=PLAN_A
PRICING_PLAN_1_FEATURES=ai,file_upload,sharing

PRICING_PLAN_2_NAME="Example Tier B"
PRICING_PLAN_2_DESCRIPTION="Demo team plan with projects & API limits"
PRICING_PLAN_2_PRICE_USD=29
PRICING_PLAN_2_LEDGER=PLAN_B
PRICING_PLAN_2_FEATURES=ai,file_upload,projects,api_limits,group_hangouts

# ── Billing / Monetization ──────────────────────────────────────────────────
BILLING_CRYPTO_PROVIDER=stub
BILLING_ENABLED_METHODS=CRYPTO
BLOCKBEE_API=
