# ─────────────────────────────────────────────────────────────────────────────
# Kylrix — Environment Variables (committed template)
# Copy to your local .env (gitignored) and fill in real values:
#   cp env.sample .env
# Or run: make setup
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ─────────────────────────────────────────────────────────────────
# Your domain (used for Caddy HTTPS and Next.js config)
# For local development, use "localhost"
DOMAIN=localhost

# ── Appwrite Configuration ─────────────────────────────────────────────────
# Endpoint URL for the Appwrite API
# If using the bundled Appwrite: http://appwrite/v1 (internal) or http://localhost:8080/v1 (external)
# If using Appwrite Cloud: https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=http://appwrite/v1

# Your Appwrite project ID (create one in the Appwrite console)
APPWRITE_PROJECT_ID=67fe9627001d97e37ef3

# Appwrite API key (create in Appwrite Console → API Keys → with needed scopes)
APPWRITE_API_KEY=

# Port to expose the Appwrite console (only for bundled Appwrite)
APPWRITE_PORT=8080

# Appwrite domain settings
APPWRITE_DOMAIN=localhost
APPWRITE_FUNCTIONS_DOMAIN=functions.localhost

# ── Application ────────────────────────────────────────────────────────────
# Full URL where the app is accessible (used in emails, redirects, etc.)
APP_URL=https://localhost

# Comma-separated list of admin user IDs
ADMINS=

# Internal secret for background job authentication
INTERNAL_JOBS_SECRET=

# ── Database (MariaDB — for bundled Appwrite) ──────────────────────────────
DB_USER=appwrite
DB_PASS=appwrite-secret-password
DB_ROOT_PASS=appwrite-root-secret

# ── Security ───────────────────────────────────────────────────────────────
# OpenSSL encryption key (min 128 bits / 32 hex chars)
# Run: openssl rand -hex 32
OPENSSL_KEY=your-secret-key-min-128-bits

# Force HTTPS on Appwrite (set to "enabled" when you have a valid domain)
FORCE_HTTPS=disabled

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Required for password resets, email verification, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# System email addresses
SYSTEM_EMAIL=noreply@localhost
SECURITY_EMAIL=security@localhost

# ── Storage Limits ─────────────────────────────────────────────────────────
# Max file upload size in bytes (default: 30MB)
STORAGE_LIMIT=30000000
STORAGE_PREVIEW_LIMIT=20000000

# ── Remember Unlock / App MEK (foundation only — not wired yet) ────────────
# Server-only wrap key (not available in the browser or offline client).
# KYLRIX_KEY=
# Optional client-inlined wrap key (weaker — ends up in the JS bundle).
# Prefer device/passkey-derived wrap when Remember Unlock is connected.
# NEXT_PUBLIC_KYLRIX_KEY=

# ── Product & Pricing ───────────────────────────────────────────────────────
PRODUCT_NAME=ExampleSuite

# Enable paid plans + checkout (cloud). false = AGPL self-host, all features open.
PRICING_TIERS_ENABLED=false

# Number of paid plans (plan1 … planN). Each lists features exclusive vs FREE.
PRICING_PLAN_COUNT=2

PRICING_PLAN_1_NAME=Example Tier A
PRICING_PLAN_1_DESCRIPTION=Demo individual plan
PRICING_PLAN_1_PRICE_USD=9
PRICING_PLAN_1_LEDGER=PLAN_A
PRICING_PLAN_1_FEATURES=ai,file_upload,sharing

# Valid feature ids (each plan lists what it includes vs FREE — repeat across plans is fine):
# ai, voice, file_upload, sharing, pinned_notes, milestones, discussions,
# oauth_provider, article_mode, projects, api_limits, group_hangouts

PRICING_PLAN_2_NAME=Example Tier B
PRICING_PLAN_2_DESCRIPTION=Demo team plan with projects & API limits
PRICING_PLAN_2_PRICE_USD=29
PRICING_PLAN_2_LEDGER=PLAN_B
PRICING_PLAN_2_FEATURES=ai,file_upload,projects,api_limits,group_hangouts

# ── Billing / Monetization ──────────────────────────────────────────────────
BILLING_CRYPTO_PROVIDER=stub
BILLING_ENABLED_METHODS=CRYPTO

# BILLING_CALLBACK_BASE_URL=https://example.com/billing
# BILLING_NOTIFY_URL=https://example.com/billing/api/pro/notify
# BILLING_SUCCESS_URL=https://example.com/billing/success

BLOCKBEE_API=
# BLOCKBEE_API_BASE=https://api.blockbee.io
